# cPanel mailbox SMTP (outgoing). IMAP/POP3 is only for reading mail in an app.
SMTP_HOST=ummeyusrafoods.com
SMTP_PORT=465
SMTP_USER=info@ummeyusrafoods.com
SMTP_PASS=

# Inbox that receives contact-form notifications.
CONTACT_TO_EMAIL=info@qostaraestimates.com

# Must be a mailbox on this SMTP account (usually the same as SMTP_USER).
CONTACT_FROM_EMAIL="Ummey Usra Foods <info@ummeyusrafoods.com>"
